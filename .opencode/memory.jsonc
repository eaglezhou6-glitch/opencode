{
  // OpenCode memory plugin config (custom)
  "memory": {
    // Memory files live under ~/.config/.opencode
    "root": "~/.config/.opencode",
    "dailyDir": "memory",
    "longTermFile": "MEMORY.md",
    // Optional: custom index location
    // "indexFile": ".opencode/memory/index.sqlite",
    "extraPaths": [],
    "chunk": {
      "maxChars": 1600,
      "overlap": 200
    }
  },
  "embedding": {
    "provider": "openai",
    "model": "text-embedding-3-small",
    "baseUrl": "https://api.openai.com/v1",
    "apiKey": "env:OPENAI_API_KEY",
    "headers": {},
    "batchSize": 64
  },
  "search": {
    "maxResults": 6,
    "minScore": 0.35,
    "snippetChars": 700
  },
  "recall": {
    "enabled": true,
    "maxResults": 6,
    "minScore": 0.35,
    "maxChars": 1600,
    "includePath": true
  },
  "flush": {
    "enabled": true,
    "mode": "llm",
    // Optional: override the main model with a provider/model pair.
    // If "model" is empty, the main model will be used.
    "provider": "",
    "model": "",
    "baseUrl": "https://api.openai.com/v1",
    "apiKey": "env:OPENAI_API_KEY",
    "headers": {},
    "maxMessages": 50,
    "maxItems": 6
  }
}
